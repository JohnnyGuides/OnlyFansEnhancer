{
  "name": "creator-workflow-toolkit",
  "version": "0.20.32",
  "private": true,
  "description": "Development checks for the personal Creator Workflow Toolkit and store-safe Fan Identity Mask edition.",
  "scripts": {
    "build:personal": "node tools/build-extensions.mjs personal",
    "build:store": "node tools/build-extensions.mjs store",
    "build:extensions": "npm run build:personal && npm run build:store",
    "build:x-teaser-host": "powershell -NoProfile -File tools/build-x-teaser-native-host.ps1",
    "stage:desktop": "powershell -NoProfile -File tools/build-desktop-package.ps1 -StageOnly",
    "build:desktop": "powershell -NoProfile -File tools/build-desktop-package.ps1",
    "test": "npm run build:extensions && node tools/run-tests.mjs portable",
    "test:structure": "node tools/run-tests.mjs structure",
    "test:packages": "node tools/run-tests.mjs packages",
    "test:unit": "npm run build:extensions && node tools/run-tests.mjs unit",
    "test:browser": "npm run build:extensions && node tools/run-tests.mjs browser",
    "test:native": "node tools/run-tests.mjs native",
    "test:windows-packaging": "node tools/run-tests.mjs windows-packaging",
    "test:dotnet": "dotnet test desktop/OFEnhancer.sln -c Release",
    "test:snapshots": "npm run build:personal && node tools/run-tests.mjs private",
    "test:desktop-shell-ui": "node tests/desktop/desktop-shell-ui.test.cjs",
    "test:desktop-catalogue-ui": "node tests/desktop/desktop-catalogue-ui.test.cjs",
    "lint": "eslint extensions/personal/workflows extensions/personal/options.js extensions/personal/realbooru-parser.js tools",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write \"{extensions,shared}/**/*.{html,css,js,json}\" \"tools/**/*.mjs\" \"tests/**/*.cjs\" \"docs/**/*.{md,html}\" \"packaging/**/*.{json,md,html}\" README.md package.json jsconfig.json eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check \"{extensions,shared}/**/*.{html,css,js,json}\" \"tools/**/*.mjs\" \"tests/**/*.cjs\" \"docs/**/*.{md,html}\" \"packaging/**/*.{json,md,html}\" README.md package.json jsconfig.json eslint.config.mjs .prettierrc.json",
    "check:web": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "check:windows": "npm run test:dotnet && npm run test:native && npm run test:windows-packaging && npm run build:x-teaser-host",
    "check": "npm run check:web && npm run check:windows"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.2.2",
    "eslint": "10.8.0",
    "playwright": "1.62.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
