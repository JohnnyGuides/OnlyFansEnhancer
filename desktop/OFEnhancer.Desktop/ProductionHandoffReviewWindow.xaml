<Window x:Class="OFEnhancer.Desktop.ProductionHandoffReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Production draft" Width="660" Height="520" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#10141B" Foreground="#EEF3F8"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#273341" />
            <Setter Property="Foreground" Value="#EEF3F8" />
            <Setter Property="BorderBrush" Value="#3A4958" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A242E" />
            <Setter Property="Foreground" Value="#EEF3F8" />
            <Setter Property="BorderBrush" Value="#425262" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="#1A242E" />
            <Setter Property="Foreground" Value="#EEF3F8" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
    </Window.Resources>
    <Grid Margin="22" Background="#10141B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Production draft" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="EpisodeText" Foreground="#ACBCCA" Margin="0,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#25352F" BorderBrush="#477A65"
                    BorderThickness="1" CornerRadius="5" Padding="9,5"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock x:Name="StatusText" Text="Awaiting review" Foreground="#A8E8CB" />
            </Border>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="Selected files" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ListBox Grid.Row="2" x:Name="FilesList" Background="#172029" Foreground="#EEF3F8"
                 BorderBrush="#344453" BorderThickness="1" Margin="0,0,0,18">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Role}" Foreground="#9FB3C2" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#9FB3C2"
                                   VerticalAlignment="Center" Margin="15,0,0,0" />
                        <Grid.ToolTip><TextBlock Text="{Binding Path}" /></Grid.ToolTip>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock Text="Catalogue item" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBox x:Name="CatalogueSearch" Height="34" TextChanged="CatalogueSearch_TextChanged"
                     ToolTip="Search catalogue" />
            <ListBox x:Name="CatalogueChoice" Height="72" DisplayMemberPath="Label"
                     Background="#172029" Foreground="#EEF3F8" BorderBrush="#344453"
                     BorderThickness="1" Margin="0,5,0,0"
                     SelectionChanged="CatalogueChoice_SelectionChanged" />
        </StackPanel>
        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock Text="Unpublished" Foreground="#9FB3C2" VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="LaterButton" Content="Later" Click="LaterButton_Click" />
                <Button x:Name="RejectButton" Content="Reject" Click="RejectButton_Click" />
                <Button x:Name="BindButton" Content="Bind files" Click="BindButton_Click"
                        Background="#216B5D" BorderBrush="#32917C" IsEnabled="False" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
