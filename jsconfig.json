{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["chrome"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "useDefineForClassFields": true
  },
  "include": [
    "extensions/personal/workflows/**/*.js",
    "extensions/personal/realbooru-parser.js"
  ]
}
